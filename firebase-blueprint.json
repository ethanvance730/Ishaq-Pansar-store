{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Herbal product sold on Ishaq Pansar Store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "urduName": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "description": { "type": "string" },
        "inStock": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "price"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["id", "name", "slug"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and contact details",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "standardShippingRate": { "type": "number" },
        "freeShippingThreshold": { "type": "number" },
        "announcementText": { "type": "string" },
        "isCodEnabled": { "type": "boolean" }
      },
      "required": ["storeName", "phone", "address"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order placed in store",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["orderNumber", "customer", "items", "total", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of herbal products"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of categories"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "General store configuration"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    }
  }
}
